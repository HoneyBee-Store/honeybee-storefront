@model List<PickupLocation>
@{
    ViewData["Title"] = "Pickup locations";
    Layout = "_AdminLayout";
}

<h1 class="h3 mb-4">Pickup locations</h1>

<div class="row g-4">
    <div class="col-lg-7">
        @foreach (var loc in Model)
        {
            <form asp-action="SaveLocation" method="post" class="admin-card p-4 mb-3">
                <input type="hidden" asp-for="@loc.Id" name="Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Name (Arabic)</label>
                        <input name="NameAr" value="@loc.NameAr" class="form-control" dir="rtl" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name (English)</label>
                        <input name="NameEn" value="@loc.NameEn" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Map link</label>
                        <input name="MapUrl" value="@loc.MapUrl" class="form-control" type="url" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Latitude</label>
                        <input name="Latitude" value="@loc.Latitude" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Longitude</label>
                        <input name="Longitude" value="@loc.Longitude" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Sort order</label>
                        <input name="SortOrder" value="@loc.SortOrder" class="form-control" type="number" />
                    </div>
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch">
                            <input name="IsActive" value="true" class="form-check-input" type="checkbox"
                                   role="switch" checked="@loc.IsActive" id="active-@loc.Id" />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label" for="active-@loc.Id">Shown on the site</label>
                        </div>
                        <button type="submit" class="btn btn-sm btn-honey">Save</button>
                    </div>
                </div>
            </form>
        }
    </div>

    <div class="col-lg-5">
        <form asp-action="SaveLocation" method="post" class="admin-card p-4">
            <h2 class="h6 text-uppercase text-body-secondary mb-3">Add a location</h2>
            <input type="hidden" name="Id" value="0" />
            <input type="hidden" name="IsActive" value="true" />
            <div class="mb-3">
                <label class="form-label">Name (Arabic)</label>
                <input name="NameAr" class="form-control" dir="rtl" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Name (English)</label>
                <input name="NameEn" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Map link</label>
                <input name="MapUrl" class="form-control" type="url"
                       placeholder="https://maps.app.goo.gl/…" />
            </div>
            <div class="mb-3">
                <label class="form-label">Sort order</label>
                <input name="SortOrder" class="form-control" type="number" value="@(Model.Count + 1)" />
            </div>
            <button type="submit" class="btn btn-honey w-100">Add location</button>
        </form>
    </div>
</div>
