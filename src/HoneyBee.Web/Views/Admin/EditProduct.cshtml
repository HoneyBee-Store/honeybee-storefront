@model ProductEditViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add product" : Model.NameEn;
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@(isNew ? "Add product" : "Edit product")</h1>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Products">Back to products</a>
</div>

<form asp-action="EditProduct" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="admin-card p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Details</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NameAr" class="form-label"></label>
                        <input asp-for="NameAr" class="form-control" dir="rtl" />
                        <span asp-validation-for="NameAr" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NameEn" class="form-label"></label>
                        <input asp-for="NameEn" class="form-control" />
                        <span asp-validation-for="NameEn" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DescriptionAr" class="form-label"></label>
                        <textarea asp-for="DescriptionAr" class="form-control" rows="4" dir="rtl"></textarea>
                        <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DescriptionEn" class="form-label"></label>
                        <textarea asp-for="DescriptionEn" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control font-monospace" />
                        <div class="form-text">Appears in the address bar: /product/<strong>@(string.IsNullOrEmpty(Model.Slug) ? "sidr-honey" : Model.Slug)</strong></div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="admin-card p-4 mt-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Price</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.001" min="0" />
                        <div class="form-text">Blank shows “price on request”, which is how the shop runs today.</div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="UnitAr" class="form-label"></label>
                        <input asp-for="UnitAr" class="form-control" dir="rtl" placeholder="كيلو" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="UnitEn" class="form-label"></label>
                        <input asp-for="UnitEn" class="form-control" placeholder="kg" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="admin-card p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Photo</h2>

                @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                {
                    <img src="~/@Model.CurrentImagePath" alt="" class="admin-preview mb-3"
                         style="object-position: center @(Model.FocalY)%;" />
                }

                <div class="mb-3">
                    <label for="image" class="form-label">Replace photo</label>
                    <input type="file" name="image" id="image" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG or WebP, up to 8 MB.</div>
                    <span class="text-danger small">@Html.ValidationMessage("image")</span>
                </div>

                <div class="mb-2">
                    <label asp-for="FocalY" class="form-label"></label>
                    <input asp-for="FocalY" class="form-range" type="range" min="0" max="100" step="1"
                           oninput="document.getElementById('focalOut').textContent = this.value + '%'" />
                    <div class="d-flex justify-content-between small text-body-secondary">
                        <span>Top</span>
                        <span id="focalOut">@Model.FocalY%</span>
                        <span>Bottom</span>
                    </div>
                    <div class="form-text">
                        Which part of the photo stays visible when it is cropped. Phone photos of
                        jars usually need a low value, or the crop shows the floor.
                    </div>
                </div>
            </div>

            <div class="admin-card p-4 mt-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Visibility</h2>

                <div class="form-check form-switch mb-2">
                    <input asp-for="InStock" class="form-check-input" role="switch" />
                    <label asp-for="InStock" class="form-check-label"></label>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                    <div class="form-text">Turning this off hides it from the shop but keeps past orders intact.</div>
                </div>

                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control" type="number" />
                <div class="form-text">Lower numbers appear first.</div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-honey">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Products">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
