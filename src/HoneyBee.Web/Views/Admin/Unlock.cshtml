@model EmailUnlockViewModel
@{
    ViewData["Title"] = "Locked";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card mt-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fs-4">🔒</span>
                    <h1 class="h4 mb-0">Mail settings</h1>
                </div>

                <p class="text-muted">
                    This page can change where order notifications are sent, so it asks
                    again even though you are signed in.
                </p>

                @if (Model.LockedFor is { } wait)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Too many attempts.</strong>
                        Try again in @Math.Ceiling(wait.TotalMinutes) minute@(Math.Ceiling(wait.TotalMinutes) == 1 ? "" : "s").
                    </div>
                }
                else
                {
                    @if (Model.Failed)
                    {
                        <div class="alert alert-danger">
                            That passphrase is not right.
                            @if (Model.AttemptsLeft > 0)
                            {
                                <text>@Model.AttemptsLeft attempt@(Model.AttemptsLeft == 1 ? "" : "s") left.</text>
                            }
                        </div>
                    }

                    <form asp-action="Unlock" method="post" autocomplete="off">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="Passphrase"></label>
                            <input class="form-control form-control-lg" asp-for="Passphrase"
                                   type="password" autocomplete="current-password"
                                   autofocus required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Unlock</button>
                    </form>

                    <p class="form-text mt-3 mb-0">
                        Stays unlocked for 20 minutes, then asks again.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
