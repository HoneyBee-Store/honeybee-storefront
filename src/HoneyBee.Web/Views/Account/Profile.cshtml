@model AppUser
@{
    ViewData["Title"] = L["My account"].Value;
}

<section class="section section--cream">
    <div class="container-hb narrow">
        <div class="panel">
            <header class="section-head" style="margin-bottom:1.75rem">
                <p class="eyebrow">@L["Account"]</p>
                <h1 class="section-title">@L["My account"]</h1>
            </header>

            <dl class="dl-clean">
                <dt>@L["Full name"]</dt>
                <dd>@Model.FullName</dd>

                <dt>@L["Phone number"]</dt>
                <dd class="u-ltr">@Model.PhoneNumber</dd>

                <dt>@L["Email"]</dt>
                <dd class="u-ltr">@Model.Email</dd>
            </dl>

            @* No order history yet — saying so beats an empty panel the
               customer cannot explain. *@
            <div class="notice notice-warn" style="margin-block:1.25rem">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <span>@L["OrdersComingSoon"]</span>
            </div>

            <form asp-action="Logout" method="post">
                <button type="submit" class="btn-hb btn-outline btn-block">@L["Sign out"]</button>
            </form>
        </div>
    </div>
</section>
