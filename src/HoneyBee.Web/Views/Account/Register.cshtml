@model CustomerRegisterViewModel
@{
    ViewData["Title"] = L["Create an account"].Value;
}

<section class="section section--cream">
    <div class="container-hb narrow">
        <div class="panel">
            <header class="section-head" style="margin-bottom:1.75rem">
                <p class="eyebrow">@L["New here"]</p>
                <h1 class="section-title">@L["Create an account"]</h1>
                <p class="section-sub" style="font-size:1rem">@L["AccountIntro"]</p>
            </header>

            <form asp-action="Register" method="post" class="stack">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="notice notice-bad" role="alert"></div>

                <div>
                    <label class="field-label" asp-for="FullName">@L["Full name"]</label>
                    <input class="field" asp-for="FullName" autocomplete="name" autofocus />
                    <span class="field-error" asp-validation-for="FullName"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="Phone">@L["Phone number"]</label>
                    <input class="field u-ltr" asp-for="Phone" type="tel" autocomplete="tel"
                           placeholder="0790000000" />
                    <span class="field-help">@L["PhoneHelp"]</span>
                    <span class="field-error" asp-validation-for="Phone"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="Email">@L["Email"]</label>
                    <input class="field u-ltr" asp-for="Email" type="email" autocomplete="email" />
                    <span class="field-error" asp-validation-for="Email"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="Password">@L["Password"]</label>
                    <input class="field" asp-for="Password" autocomplete="new-password" />
                    <span class="field-help">@L["PasswordHelp"]</span>
                    <span class="field-error" asp-validation-for="Password"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="ConfirmPassword">@L["Confirm password"]</label>
                    <input class="field" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn-hb btn-gold btn-block">@L["Create account"]</button>
            </form>

            <p class="u-center field-help" style="margin-block-start:1.5rem;margin-bottom:0">
                @L["Already have an account?"]
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Sign in"]</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
