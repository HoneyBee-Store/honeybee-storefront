@{
    ViewData["Title"] = L["Not available"].Value;
}

<section class="section section--cream">
    <div class="container-hb narrow">
        <div class="panel u-center">
            <i class="bi bi-lock-fill" style="font-size:2.5rem;color:var(--beige)" aria-hidden="true"></i>
            <h1 class="section-title" style="margin-block-start:.75rem">@L["Not available"]</h1>
            <p class="section-sub">@L["DeniedBody"]</p>
            <a class="btn-hb btn-gold" style="margin-block-start:1rem"
               asp-controller="Home" asp-action="Index">@L["Back to the shop"]</a>
        </div>
    </div>
</section>
