@model CustomerLoginViewModel
@{
    ViewData["Title"] = L["Sign in"].Value;
}

<section class="section section--cream">
    <div class="container-hb narrow">
        <div class="panel">
            <header class="section-head" style="margin-bottom:1.75rem">
                <p class="eyebrow">@L["Welcome back"]</p>
                <h1 class="section-title">@L["Sign in"]</h1>
            </header>

            <form asp-action="Login" method="post" class="stack">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="notice notice-bad" role="alert"></div>

                <div>
                    <label class="field-label" asp-for="Phone">@L["Phone number"]</label>
                    <input class="field u-ltr" asp-for="Phone" type="tel" autocomplete="tel"
                           placeholder="0790000000" autofocus />
                    <span class="field-error" asp-validation-for="Phone"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="Password">@L["Password"]</label>
                    <input class="field" asp-for="Password" autocomplete="current-password" />
                    <span class="field-error" asp-validation-for="Password"></span>
                </div>

                <label style="display:flex;align-items:center;gap:.5rem;font-size:.92rem">
                    <input asp-for="RememberMe" />
                    <span>@L["Keep me signed in"]</span>
                </label>

                <button type="submit" class="btn-hb btn-gold btn-block">@L["Sign in"]</button>
            </form>

            <p class="u-center field-help" style="margin-block-start:1.5rem;margin-bottom:0">
                @L["No account yet?"]
                <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@L["Create one"]</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
