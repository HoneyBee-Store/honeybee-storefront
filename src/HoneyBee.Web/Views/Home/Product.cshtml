@using HoneyBee.Web.Models
@model Product
@{
    ViewData["Title"] = Model.Name();
    var primary = Model.Images.FirstOrDefault(i => i.IsPrimary) ?? Model.Images.FirstOrDefault();
}

<section class="section section--cream">
    <div class="container-hb">
        <a class="crumb" asp-action="Index">
            <i class="bi bi-arrow-@(LocalizedText.IsArabic ? "right" : "left")" aria-hidden="true"></i>
            @L["Back to products"]
        </a>

        <div class="detail-grid">
            <div>
                @if (primary is not null)
                {
                    <img class="detail-img" src="~/@primary.Path" alt="@primary.Alt()" />
                }
            </div>

            <div>
                <h1 class="section-title">@Model.Name()</h1>

                <p style="margin-block-start:1.25rem">
                    @if (Model.InStock)
                    {
                        <span class="pill pill-in">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>@L["In Stock"]
                        </span>
                    }
                    else
                    {
                        <span class="pill pill-out">
                            <i class="bi bi-slash-circle" aria-hidden="true"></i>@L["Out of Stock"]
                        </span>
                    }
                </p>

                @if (Model.Price is null)
                {
                    <p class="price price--request">@L["Price on request"]</p>
                }
                else
                {
                    <p class="price" style="font-size:var(--t-3)">
                        <span>@($"{Model.Price:0.###}") @L["JOD"]</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Unit()))
                        {
                            <small>/ @Model.Unit()</small>
                        }
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description()))
                {
                    <p class="section-sub" style="margin-block-start:0">@Model.Description()</p>
                }

                <div class="panel" style="margin-block-start:1.75rem">
                    <span class="field-label">@L["Choose size and quantity"]</span>
                    <partial name="_AddToCart" model="Model" />
                    <p class="field-help" style="margin-block-start:.85rem">@L["CartNote"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
