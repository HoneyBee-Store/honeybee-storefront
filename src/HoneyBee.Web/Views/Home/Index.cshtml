@using HoneyBee.Web.Models
@model StorefrontViewModel
@{
    ViewData["Title"] = L["Home"].Value;
}

<section class="hero">
    <div class="hero-media">
        <img src="~/img/products/collection-hero.jpg" alt="" fetchpriority="high" />
        <div class="hero-scrim" aria-hidden="true"></div>
    </div>
    <div class="container-hb hero-inner">
        <p class="eyebrow">@L["Raw and Natural"]</p>
        <h1 class="hero-title">@L["Pure Honey, Straight From the Hive"]</h1>
        <p class="hero-lead">@L["HeroLead"]</p>
        <div class="hero-actions">
            <a class="btn-hb btn-gold" href="#products">
                <i class="bi bi-basket2" aria-hidden="true"></i>@L["Shop now"]
            </a>
            <a class="btn-hb btn-ghost-gold" href="#about">@L["Our Story"]</a>
        </div>
    </div>
</section>

<!-- ============================ WHY US ============================ -->
<section class="section section--cream">
    <div class="container-hb">
        <div class="value-grid">
            <div class="value-card reveal">
                <div class="value-icon"><i class="bi bi-flower1" aria-hidden="true"></i></div>
                <h3>@L["100% Natural"]</h3>
                <p>@L["ValueNatural"]</p>
            </div>
            <div class="value-card reveal">
                <div class="value-icon"><i class="bi bi-droplet-half" aria-hidden="true"></i></div>
                <h3>@L["Raw and Unfiltered"]</h3>
                <p>@L["ValueRaw"]</p>
            </div>
            <div class="value-card reveal">
                <div class="value-icon"><i class="bi bi-house-heart" aria-hidden="true"></i></div>
                <h3>@L["Family Harvested"]</h3>
                <p>@L["ValueFamily"]</p>
            </div>
            <div class="value-card reveal">
                <div class="value-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
                <h3>@L["Collect in person"]</h3>
                <p>@L["ValuePickup"]</p>
            </div>
        </div>
    </div>
</section>

<!-- ============================ PRODUCTS ============================ -->
<section id="products" class="section section--beige">
    <div class="container-hb">
        <header class="section-head section-head--center">
            <p class="eyebrow">@L["Our harvest"]</p>
            <h2 class="section-title">@L["Our Products"]</h2>
            <p class="section-sub">@L["ProductsIntro"]</p>
        </header>

        <div class="product-grid">
            @foreach (var p in Model.Products)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    </div>
</section>

<!-- ============================ STORY ============================ -->
<section id="about" class="section section--cream">
    <div class="container-hb">
        <div class="story-grid">
            <div class="reveal">
                <p class="eyebrow">@L["Our Story"]</p>
                <h2 class="section-title">@L["StoryHeading"]</h2>
                <p class="section-sub">@L["StoryBody"]</p>
                <div class="row-wrap" style="margin-block-start:1.75rem">
                    <a class="btn-hb btn-choc" href="#products">@L["View Products"]</a>
                    <a class="btn-hb btn-outline" href="#contact">@L["Contact"]</a>
                </div>
            </div>
            <div class="reveal">
                <img class="story-img" src="~/img/products/honeycomb-cut.jpg" alt="@L["StoryImageAlt"]" loading="lazy" />
            </div>
        </div>
    </div>
</section>

<!-- ============================ CONTACT ============================ -->
<section id="contact" class="section section--choc">
    <div class="container-hb">
        <header class="section-head section-head--center">
            <p class="eyebrow">@L["Contact"]</p>
            <h2 class="section-title" style="color:#fff">@L["Get in Touch"]</h2>
            <p class="section-sub" style="color:rgba(240,230,206,.8)">@L["ContactIntro"]</p>
        </header>

        <div class="narrow-md">
            <ul class="contact-list">
                <li class="contact-item reveal">
                    <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                    <div>
                        <span class="contact-label">@L["To contact and order"]</span>
                        <a class="u-ltr" href="@Model.PhoneHref">@Model.Phone</a>
                    </div>
                </li>
                <li class="contact-item reveal">
                    <i class="bi bi-envelope-at-fill" aria-hidden="true"></i>
                    <div>
                        <span class="contact-label">@L["Email"]</span>
                        <a class="u-ltr" href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                </li>
                <li class="contact-item reveal">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    <div>
                        <span class="contact-label">@L["For pickup"]</span>
                        @foreach (var loc in Model.PickupLocations)
                        {
                            <a class="map-link" href="@loc.MapUrl" target="_blank" rel="noopener">
                                @loc.Name() <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </div>
</section>
