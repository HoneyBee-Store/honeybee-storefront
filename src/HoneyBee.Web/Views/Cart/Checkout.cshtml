@model CheckoutViewModel
@{
    ViewData["Title"] = L["Confirm your request"].Value;
}

<section class="section section--cream">
    <div class="container-hb">
        <header class="section-head">
            <p class="eyebrow">@L["Almost done"]</p>
            <h1 class="section-title">@L["Confirm your request"]</h1>
        </header>

        <form asp-action="Checkout" method="post" id="checkoutForm">
            <div class="cart-layout">
                <div class="panel">
                    <div asp-validation-summary="ModelOnly" class="notice notice-bad" role="alert"
                         style="margin-bottom:1.25rem"></div>

                    <div class="stack">
                        <div>
                            <label class="field-label" asp-for="CustomerName">@L["Full name"]</label>
                            <input class="field" asp-for="CustomerName" autocomplete="name" />
                            <span class="field-error" asp-validation-for="CustomerName"></span>
                        </div>

                        <div>
                            <label class="field-label" asp-for="Phone">@L["Phone number"]</label>
                            <input class="field u-ltr" asp-for="Phone" type="tel" autocomplete="tel"
                                   placeholder="0790000000" />
                            <span class="field-help">@L["CheckoutPhoneHelp"]</span>
                            <span class="field-error" asp-validation-for="Phone"></span>
                        </div>

                        <div>
                            <label class="field-label" asp-for="PickupLocationId">@L["Pickup location"]</label>
                            <select class="field" asp-for="PickupLocationId">
                                <option value="">@L["Choose a location"]</option>
                                @foreach (var loc in Model.PickupLocations)
                                {
                                    <option value="@loc.Id">@loc.Name()</option>
                                }
                            </select>
                            <span class="field-error" asp-validation-for="PickupLocationId"></span>
                            @* Answers the question here, where someone picking a
                               location is most likely to be wondering it. *@
                            <p class="field-help">@L["DeliverySoon"]</p>
                        </div>

                        <div>
                            <label class="field-label" asp-for="CustomerNotes">@L["Notes (optional)"]</label>
                            <textarea class="field" asp-for="CustomerNotes" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <aside class="panel">
                    <h2 style="font-size:var(--t-1);margin-bottom:1rem">@L["Summary"]</h2>

                    <div class="stack-sm" style="margin-bottom:1rem">
                        @foreach (var line in Model.Cart.Lines)
                        {
                            <div class="summary-row" style="padding-block:.15rem">
                                <span>
                                    @line.Product.Name()
                                    <span class="cart-line-meta">
                                        — @(line.SizeKg == 1m ? "1" : "½") @L["kg"] × @line.Quantity
                                    </span>
                                </span>
                                <span class="u-nowrap">
                                    @if (line.LineTotal is not null)
                                    {
                                        @($"{line.LineTotal:0.###}")
                                    }
                                </span>
                            </div>
                        }
                    </div>

                    <div class="summary-row summary-total">
                        <span>@L["Total"]</span>
                        <span>
                            @if (Model.Cart.Total is null)
                            {
                                @L["Price on request"]
                            }
                            else
                            {
                                @($"{Model.Cart.Total:0.###}") <text> </text> @L["JOD"]
                            }
                        </span>
                    </div>

                    <button type="submit" class="btn-hb btn-gold btn-block" id="checkoutSubmit"
                            style="margin-block-start:1.25rem">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>@L["Send request"]
                    </button>

                    <p class="field-help" style="margin-block-start:1rem">@L["CheckoutNote"]</p>
                </aside>
            </div>

            @* No reference to quote yet — the order does not exist until this
               form is posted. Passed explicitly as null, because the <partial>
               tag helper falls back to the *parent* view's model when none is
               given, which handed this page's CheckoutViewModel to a partial
               declaring @@model string and threw on every checkout. *@
            @await Html.PartialAsync("_CliqPanel", (string?)null)
        </form>
    </div>
</section>

@*
    Shown when the button is pressed and the transfer has not been confirmed
    yet. It is a dialog rather than a browser alert() so it can carry the order
    number and the shop's own voice — and because alert() is suppressed outright
    by some mobile browsers, which would leave the button looking broken.

    Rendered here rather than built in script so it is translated on the server
    like everything else on the page.
*@
<dialog class="hb-dialog" id="waitDialog" aria-labelledby="waitDialogTitle">
    <div class="hb-dialog-body">
        <i class="bi bi-hourglass-split hb-dialog-icon" aria-hidden="true"></i>
        <h2 class="hb-dialog-title" id="waitDialogTitle">@L["Waiting for approval"]</h2>
        <p class="hb-dialog-text" id="waitDialogText">@L["WaitForApproval"]</p>
        <p class="order-ref" id="waitDialogRef" hidden></p>
        <p class="field-help">@L["WaitForApprovalHint"]</p>
        <button type="button" class="btn-hb btn-gold btn-block" data-close-dialog>@L["Got it"]</button>
    </div>
</dialog>

@*
    Same three outcomes for anyone whose JavaScript did not run. The server
    redirects back here with the state in TempData, so the button still works
    without scripts — it just costs a page load per press.
*@
@if (TempData["CheckoutState"] is string noScriptState)
{
    <div class="container-hb" style="padding-block-end:2rem">
        <div class="notice @(noScriptState == "cancelled" ? "notice-bad" : "notice-warn")" role="alert">
            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
            <span>
                @TempData["CheckoutMessage"]
                @if (TempData["PendingOrder"] is string pendingRef)
                {
                    <strong class="u-ltr" dir="ltr" style="margin-inline-start:.35rem">@pendingRef</strong>
                }
            </span>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
