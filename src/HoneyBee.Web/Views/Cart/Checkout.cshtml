@model CheckoutViewModel
@{
    ViewData["Title"] = L["Confirm your request"].Value;
}

<section class="section section--cream">
    <div class="container-hb">
        <header class="section-head">
            <p class="eyebrow">@L["Almost done"]</p>
            <h1 class="section-title">@L["Confirm your request"]</h1>
        </header>

        <form asp-action="Checkout" method="post">
            <div class="cart-layout">
                <div class="panel">
                    <div asp-validation-summary="ModelOnly" class="notice notice-bad" role="alert"
                         style="margin-bottom:1.25rem"></div>

                    <div class="stack">
                        <div>
                            <label class="field-label" asp-for="CustomerName">@L["Full name"]</label>
                            <input class="field" asp-for="CustomerName" autocomplete="name" />
                            <span class="field-error" asp-validation-for="CustomerName"></span>
                        </div>

                        <div>
                            <label class="field-label" asp-for="Phone">@L["Phone number"]</label>
                            <input class="field u-ltr" asp-for="Phone" type="tel" autocomplete="tel"
                                   placeholder="0790000000" />
                            <span class="field-help">@L["CheckoutPhoneHelp"]</span>
                            <span class="field-error" asp-validation-for="Phone"></span>
                        </div>

                        <div>
                            <label class="field-label" asp-for="PickupLocationId">@L["Pickup location"]</label>
                            <select class="field" asp-for="PickupLocationId">
                                <option value="">@L["Choose a location"]</option>
                                @foreach (var loc in Model.PickupLocations)
                                {
                                    <option value="@loc.Id">@loc.Name()</option>
                                }
                            </select>
                            <span class="field-error" asp-validation-for="PickupLocationId"></span>
                        </div>

                        <div>
                            <label class="field-label" asp-for="CustomerNotes">@L["Notes (optional)"]</label>
                            <textarea class="field" asp-for="CustomerNotes" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <aside class="panel">
                    <h2 style="font-size:var(--t-1);margin-bottom:1rem">@L["Summary"]</h2>

                    <div class="stack-sm" style="margin-bottom:1rem">
                        @foreach (var line in Model.Cart.Lines)
                        {
                            <div class="summary-row" style="padding-block:.15rem">
                                <span>
                                    @line.Product.Name()
                                    <span class="cart-line-meta">
                                        — @(line.SizeKg == 1m ? "1" : "½") @L["kg"] × @line.Quantity
                                    </span>
                                </span>
                                <span class="u-nowrap">
                                    @if (line.LineTotal is not null)
                                    {
                                        @($"{line.LineTotal:0.###}")
                                    }
                                </span>
                            </div>
                        }
                    </div>

                    <div class="summary-row summary-total">
                        <span>@L["Total"]</span>
                        <span>
                            @if (Model.Cart.Total is null)
                            {
                                @L["Price on request"]
                            }
                            else
                            {
                                @($"{Model.Cart.Total:0.###}") <text> </text> @L["JOD"]
                            }
                        </span>
                    </div>

                    <button type="submit" class="btn-hb btn-gold btn-block" style="margin-block-start:1.25rem">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>@L["Send request"]
                    </button>

                    <p class="field-help" style="margin-block-start:1rem">@L["CheckoutNote"]</p>
                </aside>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
