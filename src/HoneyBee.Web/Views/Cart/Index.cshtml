@model CartViewModel
@{
    ViewData["Title"] = L["My request"].Value;
}

<section class="section section--cream">
    <div class="container-hb">
        <header class="section-head">
            <p class="eyebrow">@L["Your selection"]</p>
            <h1 class="section-title">@L["My request"]</h1>
        </header>

        @if (TempData["JustOrdered"] is string justOrdered)
        {
            @* Shown if they come back after submitting — WhatsApp may not have
               opened on a desktop without the app, and without this there would
               be nothing on the site telling them the order went through. *@
            <div class="notice notice-ok" style="margin-bottom:1.5rem">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>
                    @L["Request sent"] — <strong>@justOrdered</strong>
                    <a asp-action="Confirmation" asp-route-orderNumber="@justOrdered"
                       style="margin-inline-start:.5rem">@L["View details"]</a>
                </span>
            </div>
        }

        @if (Model.IsEmpty)
        {
            <div class="panel empty-state">
                <i class="bi bi-basket2" aria-hidden="true"></i>
                <p style="margin-block-start:1rem">@L["Your request is empty."]</p>
                <a class="btn-hb btn-gold" asp-controller="Home" asp-action="Index">@L["View Products"]</a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div class="panel panel--flush">
                    @foreach (var line in Model.Lines)
                    {
                        var img = line.Product.Images.FirstOrDefault();
                        <div class="cart-line">
                            @if (img is not null)
                            {
                                <img class="cart-thumb" src="~/@img.Path" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span></span>
                            }

                            <div>
                                <div class="cart-line-name">@line.Product.Name()</div>
                                <div class="cart-line-meta">
                                    @(line.SizeKg == 1m ? "1" : "½") @L["kg"]
                                    @if (line.UnitPrice is not null)
                                    {
                                        <span> · @($"{line.UnitPrice:0.###}") @L["JOD"]</span>
                                    }
                                </div>

                                <form asp-action="Update" method="post" class="cart-line-actions"
                                      style="margin-block-start:.5rem">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <input type="hidden" name="sizeKg" value="@line.SizeKg" />
                                    <label class="visually-hidden" for="q-@line.Product.Id-@line.SizeKg">@L["Quantity"]</label>
                                    <input class="form-qty qty-input" type="number" name="quantity"
                                           id="q-@line.Product.Id-@line.SizeKg"
                                           value="@line.Quantity" min="0" max="99" />
                                    <button type="submit" class="btn-hb btn-outline btn-sm-hb">@L["Update"]</button>
                                </form>
                            </div>

                            <div class="u-nowrap" style="text-align:end">
                                @if (line.LineTotal is not null)
                                {
                                    <div class="price" style="margin:0 0 .4rem">
                                        <span>@($"{line.LineTotal:0.###}") @L["JOD"]</span>
                                    </div>
                                }
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <input type="hidden" name="sizeKg" value="@line.SizeKg" />
                                    <button type="submit" class="btn-hb btn-outline btn-sm-hb"
                                            aria-label="@L["Remove"]">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <aside class="panel">
                    <h2 style="font-size:var(--t-1);margin-bottom:1rem">@L["Summary"]</h2>

                    <div class="summary-row">
                        <span>@L["Items"]</span>
                        <span>@Model.TotalItems</span>
                    </div>
                    <div class="summary-row summary-total">
                        <span>@L["Total"]</span>
                        <span>
                            @if (Model.Total is null)
                            {
                                @L["Price on request"]
                            }
                            else
                            {
                                @($"{Model.Total:0.###}") <text> </text> @L["JOD"]
                            }
                        </span>
                    </div>

                    <a class="btn-hb btn-gold btn-block" style="margin-block-start:1.25rem"
                       asp-action="Checkout">@L["Continue"]</a>

                    <p class="field-help" style="margin-block-start:1rem">@L["CartNote"]</p>
                </aside>
            </div>
        }

        @{
            // Arabic for the customer, not the enum's English. Awaiting payment
            // is the one they will actually be looking for.
            Func<OrderStatus, string> statusLabel = status => status switch
            {
                OrderStatus.AwaitingPayment => L["StatusAwaitingPayment"].Value,
                OrderStatus.New             => L["StatusNew"].Value,
                OrderStatus.Confirmed       => L["StatusConfirmed"].Value,
                OrderStatus.Ready           => L["StatusReady"].Value,
                OrderStatus.Collected       => L["StatusCollected"].Value,
                OrderStatus.Cancelled       => L["StatusCancelled"].Value,
                _                           => status.ToString()
            };

            Func<OrderStatus, string> statusClass = status => status switch
            {
                OrderStatus.AwaitingPayment => "order-chip--wait",
                OrderStatus.Cancelled       => "order-chip--bad",
                OrderStatus.Collected       => "order-chip--ok",
                _                           => "order-chip--on"
            };
        }

        <section class="past-orders">
            <h2 class="section-title" style="font-size:var(--t-1)">@L["Previous requests"]</h2>

            @if (Model.PreviousOrders.Count == 0)
            {
                <div class="panel">
                    <p class="field-help" style="margin:0">@L["NoPreviousOrders"]</p>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        @* The honest reason they vanish: without an account there
                           is nothing durable to tie an order to. *@
                        <p class="field-help" style="margin-block-start:.5rem">
                            @L["PreviousOrdersGuestHint"]
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="panel panel--flush">
                    @foreach (var order in Model.PreviousOrders)
                    {
                        <a class="past-order" asp-action="Confirmation"
                           asp-route-orderNumber="@order.OrderNumber">
                            <span class="past-order-main">
                                <strong class="u-ltr" dir="ltr">@order.OrderNumber</strong>
                                <span class="cart-line-meta">
                                    @order.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                                    · @order.Items.Sum(i => i.Quantity) @L["Items"]
                                </span>
                            </span>
                            <span class="past-order-side">
                                @if (order.Total is not null)
                                {
                                    <span class="u-nowrap">@($"{order.Total:0.###}") @L["JOD"]</span>
                                }
                                <span class="order-chip @statusClass(order.Status)">
                                    @statusLabel(order.Status)
                                </span>
                            </span>
                        </a>
                    }
                </div>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="field-help" style="margin-block-start:1rem">
                        @L["PreviousOrdersGuestHint"]
                    </p>
                }
            }
        </section>
    </div>
</section>
