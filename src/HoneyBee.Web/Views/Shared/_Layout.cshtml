@using HoneyBee.Web.Models
@{
    var isAr = LocalizedText.IsArabic;
    var lang = isAr ? "ar" : "en";
    var dir = isAr ? "rtl" : "ltr";

    // The direction is known server-side, so the correct Bootstrap build is
    // linked directly. v1 had to ship both and swap them in JavaScript.
    var bootstrapCss = isAr
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["HoneyBee Shop"]</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%AF%3C/text%3E%3C/svg%3E" />
    <link rel="stylesheet" href="@bootstrapCss" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">@L["Skip to main content"]</a>

    <nav class="navbar navbar-expand-lg sticky-top site-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">🍯</span>
                <span>@L["HoneyBee Shop"]</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navLinks" aria-controls="navLinks" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="btn btn-sm btn-honey nav-call" href="tel:+962780364203">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                <span dir="ltr">+962 78 036 4203</span>
            </a>

            <div class="collapse navbar-collapse" id="navLinks">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@L["Home"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/#products">@L["Products"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/#about">@L["Our Story"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/#contact">@L["Contact"]</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* The owner has their own area; customers get their profile. *@
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Products">@L["Admin"]</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">@L["My account"]</a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">@L["Sign in"]</a>
                        </li>
                    }

                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="lang-form">
                            <input type="hidden" name="culture" value="@(isAr ? "en" : "ar")" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm btn-theme">
                                <i class="bi bi-translate" aria-hidden="true"></i>
                                <span class="ms-1">@(isAr ? "English" : "عربي")</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <p class="mb-0 small text-body-secondary">
                &copy; @DateTime.Now.Year @L["HoneyBee Shop"]. @L["All rights reserved."]
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
