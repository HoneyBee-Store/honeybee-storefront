@using HoneyBee.Web.Models
@{
    var isAr = LocalizedText.IsArabic;
    var lang = isAr ? "ar" : "en";
    var dir  = isAr ? "rtl" : "ltr";

    // Direction is known server-side, so the correct Bootstrap build is linked
    // directly — and from wwwroot, not a CDN: jsdelivr times out on some
    // networks, which left the page rendering as unstyled markup.
    var bootstrapCss = isAr
        ? "~/lib/bootstrap/dist/css/bootstrap.rtl.min.css"
        : "~/lib/bootstrap/dist/css/bootstrap.min.css";

    var returnUrl  = $"{Context.Request.Path}{Context.Request.QueryString}";
    var cartCount  = Context.Session.GetCart().TotalItems;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["HoneyBee Shop"]</title>
    <meta name="description" content="@L["MetaDescription"]" />
    <meta name="theme-color" content="#2A1D12" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%AF%3C/text%3E%3C/svg%3E" />

    @* Url.Content, not a bare "~/…": the tilde is only expanded for literal
       attribute values, so a path held in a variable would 404. *@
    <link rel="stylesheet" href="@Url.Content(bootstrapCss)" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">@L["Skip to main content"]</a>

    <header class="site-header">
        <div class="container-hb nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">🍯</span>
                <span>@L["HoneyBee Shop"]</span>
            </a>

            <button class="nav-toggle" type="button" id="navToggle"
                    aria-controls="navCollapse" aria-expanded="false" aria-label="@L["Menu"]">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>

            <div class="nav-collapse" id="navCollapse">
                <ul class="nav-links">
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">@L["Home"]</a></li>
                    <li><a class="nav-link" href="~/#products">@L["Products"]</a></li>
                    <li><a class="nav-link" href="~/#about">@L["Our Story"]</a></li>
                    <li><a class="nav-link" href="~/#contact">@L["Contact"]</a></li>
                </ul>

                <div class="nav-actions">
                    <a class="nav-call" href="tel:+962780364203">
                        <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                        <span class="u-ltr">+962 78 036 4203</span>
                    </a>

                    <a class="icon-btn" asp-controller="Cart" asp-action="Index"
                       aria-label="@L["My request"]">
                        <i class="bi bi-basket2" aria-hidden="true"></i>
                        @if (cartCount > 0)
                        {
                            <span class="cart-count">@cartCount</span>
                        }
                    </a>

                    @if (isSignedIn && User.IsInRole(Roles.Admin))
                    {
                        <a class="icon-btn" asp-controller="Admin" asp-action="Products">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span>@L["Admin"]</span>
                        </a>
                    }
                    else if (isSignedIn)
                    {
                        <a class="icon-btn" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <span>@L["My account"]</span>
                        </a>
                    }
                    else
                    {
                        <a class="icon-btn" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <span>@L["Sign in"]</span>
                        </a>
                    }

                    <form asp-controller="Home" asp-action="SetLanguage" method="post">
                        <input type="hidden" name="culture" value="@(isAr ? "en" : "ar")" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="icon-btn">
                            <i class="bi bi-translate" aria-hidden="true"></i>
                            <span>@(isAr ? "English" : "عربي")</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main id="main">
        @if (TempData["CartMessage"] is string cartMessage)
        {
            <div class="container-hb" style="padding-block-start:1.25rem">
                <div class="notice notice-ok">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    <span>@cartMessage</span>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-hb">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">🍯 @L["HoneyBee Shop"]</div>
                    <p class="footer-text">@L["FooterBlurb"]</p>
                </div>
                <div>
                    <div class="footer-title">@L["Explore"]</div>
                    <ul class="footer-list">
                        <li><a href="~/#products">@L["Products"]</a></li>
                        <li><a href="~/#about">@L["Our Story"]</a></li>
                        <li><a href="~/#contact">@L["Contact"]</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">@L["My request"]</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-title">@L["To contact and order"]</div>
                    <ul class="footer-list">
                        <li><a class="u-ltr" href="tel:+962780364203">+962 78 036 4203</a></li>
                        <li><a class="u-ltr" href="mailto:khaledehmide3@gmail.com">khaledehmide3@gmail.com</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year @L["HoneyBee Shop"]. @L["All rights reserved."]</span>
                <span>@L["Zarqa"] · @L["Amman"]</span>
            </div>
        </div>
    </footer>

    <a class="wa-float" href="https://wa.me/962799423449" target="_blank" rel="noopener"
       aria-label="@L["Send on WhatsApp"]">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>
    </a>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
