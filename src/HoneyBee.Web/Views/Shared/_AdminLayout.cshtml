@*
    Admin chrome stays English and LTR regardless of the storefront language.
    It is an internal tool, and its forms edit Arabic *and* English fields side
    by side — flipping the whole page to RTL makes those pairs harder to read,
    not easier.
*@
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HoneyBee Admin</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%AF%3C/text%3E%3C/svg%3E" />
    @* Self-hosted, like the storefront: jsdelivr times out on the shop's own
       network, which left the admin rendering as unstyled markup. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-lg admin-nav">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Admin" asp-action="Products">
                    <span aria-hidden="true">🍯</span> HoneyBee Admin
                </a>
                <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                    <a class="nav-link" asp-controller="Admin" asp-action="Products">Products</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Locations">Pickup</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Orders">Orders</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Email">Email</a>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" target="_blank">
                        View site <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i>
                    </a>
                    <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                </div>
            </div>
        </nav>
    }

    <main class="container py-4">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* jQuery first: the validation scripts a view may pull in through
       _ValidationScriptsPartial depend on it, and without it every admin page
       using them threw "jQuery is not defined" and silently lost client-side
       validation. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
