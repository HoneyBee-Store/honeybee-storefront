<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fd21a31c-5ff0-4e91-b551-c1ff51a29f0e</UserSecretsId>

    <!--
      This machine's application-control policy refuses to launch freshly
      compiled .exe files, so the apphost that `dotnet run` normally produces
      is blocked ("Access is denied"). Turning it off makes the build emit only
      HoneyBee.Web.dll, which runs through the signed dotnet host instead.
      Harmless in production too — `dotnet HoneyBee.Web.dll` is the usual way
      to start the app in a container anyway.
    -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
